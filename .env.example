# Non-secret identifiers and policy only. Copy to server-side .env and chmod 600.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8930
# Keep the localhost defaults unless a trusted remote MCP client needs access.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PUBLIC_BASE_URL=https://127.0.0.1:8930
GATEWAY_TENANT_ID=00000000-0000-0000-0000-000000000000
GATEWAY_CLIENT_ID=00000000-0000-0000-0000-000000000000
GATEWAY_DOWNSTREAM_SCOPE=api://00000000-0000-0000-0000-000000000000/.default
GATEWAY_ENERGY_API_URL=http://energy-api:8931
GATEWAY_CERTIFICATE_PATH=/run/secrets/gateway.pem
GATEWAY_CERTIFICATE_HOST_PATH=./secrets/gateway.pem
GATEWAY_CERTIFICATE_THUMBPRINT=
GATEWAY_REQUIRED_READ_SCOPE=Mcp.Read
GATEWAY_REQUIRED_CONTROL_SCOPE=Mcp.Control
GATEWAY_CONTROL_SCOPE_ENABLED=false
GATEWAY_OPERATOR_ROLE=Operator
GATEWAY_READER_ROLE=Reader
GATEWAY_ALLOWED_HOSTS=["127.0.0.1:8930","localhost:8930"]
GATEWAY_ALLOWED_ORIGINS=[]
GATEWAY_AUTH_DISABLED=false

ENERGY_HOST=0.0.0.0
ENERGY_PORT=8931
ENERGY_TENANT_ID=00000000-0000-0000-0000-000000000000
ENERGY_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENERGY_REQUIRED_READ_SCOPE=Energy.Read
ENERGY_REQUIRED_CONTROL_SCOPE=Energy.Control
ENERGY_APP_READ_ROLE=Energy.Read.All
ENERGY_OPERATOR_ROLE=Operator
ENERGY_EG4_BASE_URL=https://monitor.eg4electronics.com
ENERGY_EG4_USERNAME_FILE=/run/secrets/eg4_username
ENERGY_EG4_PASSWORD_FILE=/run/secrets/eg4_password
ENERGY_INVERTER_ALLOWLIST=[]
ENERGY_PLANT_ALLOWLIST=[]
ENERGY_EG4_MODE=mock
ENERGY_CONTROL_ENABLED=false
ENERGY_MAX_QUICK_CHARGE_MINUTES=30
ENERGY_PLAN_TTL_SECONDS=120
ENERGY_AUTH_DISABLED=false
